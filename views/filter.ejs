<!DOCTYPE html>
<html lang="hu">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Termékek szűrése kategória szerint</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <main>
    <h1>termékek szűrése kategória szerint</h1>
    <nav aria-label="Termékműveletek">
      <a href="/">Összes termék</a>
      <a href="/new">uj termék felvétele</a>
    </nav>
    <form action="/filter" method="get">
      <label for="category">Kategória</label>
      <select id="category" name="category">
        <option value="">öszes kategória</option>
        <% categories.forEach((category) => { %>
          <option value="<%= category %>" <%= selectedCategory === category ? 'selected' : '' %>><%= category %></option>
        <% }); %>
      </select>
      <button type="submit">Szürés</button>
    </form>
    <table>
      <thead>
        <tr>
          <th scope="col">termek neve</th>
          <th scope="col">kategoria</th>
          <th scope="col">ar</th>
          <th scope="col">raktarkész</th>
        </tr>
      </thead>
      <tbody>
        <% products.forEach((product) => { %>
          <tr class="<%= product.stock === 0 ? 'out-of-stock' : '' %>">
            <td><%= product.name %></td>
            <td><%= product.category %></td>
            <td><%= product.price.toLocaleString('hu-HU') %> Ft</td>
            <td class="<%= product.stock > 0 && product.stock < 5 ? 'low-stock' : '' %>">
              <%= product.stock %>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </main>
</body>
</html>
